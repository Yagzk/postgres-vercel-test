# PostgreSQL Bağlantı Dizesi (Connection String)
# Neon, Supabase, Render, Railway, Vercel Postgres, AWS RDS veya Yerel veritabanınız
DATABASE_URL="postgres://username:password@host:5432/database_name?sslmode=require"

# Vercel Postgres kullanıyorsanız bu değişkenler de otomatik olarak desteklenir:
# POSTGRES_URL="postgres://username:password@host:5432/database_name?sslmode=require"
# POSTGRES_PRISMA_URL="postgres://username:password@host:5432/database_name?sslmode=require"
